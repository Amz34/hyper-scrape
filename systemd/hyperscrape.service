[Unit]
Description=HyperScrape 3-Tier Enterprise Web Extraction Microservice
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hyper-scrape
ExecStart=/usr/local/bin/uvicorn hyperscrape.server:app --host 0.0.0.0 --port 8777 --workers 2
Restart=always
RestartSec=3
Environment=PYTHONPATH=/home/ubuntu/hyper-scrape

[Install]
WantedBy=multi-user.target
