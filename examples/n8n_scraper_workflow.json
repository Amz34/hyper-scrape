{
  "name": "Hybrid Scraper & RAG Ingestion Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-scrape",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://100.110.242.47:8777/scrape",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.body.url }}"
            },
            {
              "name": "engine",
              "value": "={{ $json.body.engine || 'auto' }}"
            },
            {
              "name": "css_selector",
              "value": "={{ $json.body.css_selector || 'title::text' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Hybrid Scraper HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8989/",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "rag_add"
            },
            {
              "name": "topic",
              "value": "={{ $json.url }}"
            },
            {
              "name": "content",
              "value": "={{ $json.extracted || $json.title }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Index to Local Vector RAG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Hybrid Scraper HTTP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hybrid Scraper HTTP": {
      "main": [
        [
          {
            "node": "Index to Local Vector RAG",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
